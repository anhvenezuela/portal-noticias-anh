        function seleccionarInformeDirecto(id) {
            if (!id) return;
            abrirModalLectura(id);
        }

        function toggleAcordeonBuscador() {
            const contenido = document.getElementById("contenidoAcordeon");
            const icono = document.getElementById("iconoAcordeon");
            contenido.classList.toggle("hidden");
            icono.classList.toggle("rotate-180");
        }

        // --- MODAL DE LECTURA Y CITAS ---
        function abrirModalLectura(id) {
            const db = obtenerDB();
            const j = db.jornadas.find(item => item.id === id);
            if (!j) return;

            noticiaSeleccionadaParaCita = j;

            document.getElementById("modalCatBadge").innerText = j.lugar;
            document.getElementById("modalTitulo").innerText = j.titulo;
            document.getElementById("modalSubInfo").innerHTML = `<i class="fa-regular fa-calendar mr-1"></i> ${j.fecha} &nbsp;|&nbsp; <i class="fa-solid fa-pen-nib mr-1"></i> ${j.autor}`;
            document.getElementById("modalSumario").innerText = j.sumario;
            document.getElementById("modalContenido").innerText = j.contenido;

            const imgContainer = document.getElementById("modalImagenContainer");
            const imgElem = document.getElementById("modalImagen");
            if (j.imagen) {
                imgElem.src = j.imagen;
                imgContainer.classList.remove("hidden");
            } else {
                imgContainer.classList.add("hidden");
            }

            document.getElementById("modalLectura").classList.remove("hidden");
        }

        function cerrarModalLectura() {
            document.getElementById("modalLectura").classList.add("hidden");
        }

        function copiarCitaBibliografica() {
            if (!noticiaSeleccionadaParaCita) return;
            const j = noticiaSeleccionadaParaCita;
            const anio = j.fecha.split("-")[0];
            const citaAPA = `${j.autor}. (${anio}). *${j.titulo}*. Academia Nacional de la Historia. Recuperado del portal oficial.`;
            
            navigator.clipboard.writeText(citaAPA).then(() => {
                alert("¡Cita bibliográfica en formato APA copiada al portapapeles con éxito!");
            }).catch(err => {
                console.error("Error al copiar: ", err);
            });
        }

        // --- GRÁFICO HISTÓRICO ---
        function actualizarGraficoLineasAnual() {
            const db = obtenerDB();
            const filtroCat = document.getElementById("filtroMaterialGrafico").value;

            // Agrupar por Años
            const anosMap = {};
            db.jornadas.forEach(j => {
                const anio = j.fecha ? j.fecha.split("-")[0] : "2026";
                if (filtroCat === "todos" || j.lugar === filtroCat) {
                    anosMap[anio] = (anosMap[anio] || 0) + 1;
                }
            });

            const anosOrdenados = Object.keys(anosMap).sort();
            const valores = anosOrdenados.map(a => anosMap[a]);

            // Si no hay datos, mostrar año actual en cero
            if (anosOrdenados.length === 0) {
                anosOrdenados.push("2026");
                valores.push(0);
            }

            const ctx = document.getElementById("lineChartCanvas").getContext("2d");
            if (lineChartInstance) {
                lineChartInstance.destroy();
            }

            lineChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: anosOrdenados,
                    datasets: [{
                        label: filtroCat === "todos" ? 'Total Publicaciones' : filtroCat,
                        data: valores,
                        borderColor: '#B48A3E',
                        backgroundColor: 'rgba(180, 138, 62, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'bottom' }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }

        // --- ADMINISTRACIÓN Y CRUD ---
        function renderizarTablaAdmin(jornadas) {
            const tbody = document.getElementById("tablaAdminJornadas");
            tbody.innerHTML = "";

            if (jornadas.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-500">No hay publicaciones registradas.</td></tr>`;
                return;
            }

            jornadas.forEach(j => {
                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="p-3 whitespace-nowrap text-slate-600">${j.fecha}</td>
                    <td class="p-3 font-bold text-[#1B365D] font-serif max-w-xs truncate">${j.titulo}</td>
                    <td class="p-3"><span class="bg-amber-50 text-[#B48A3E] px-2 py-0.5 rounded text-xs border border-amber-200">${j.lugar}</span></td>
                    <td class="p-3 text-slate-600">${j.autor}</td>
                    <td class="p-3 text-center">${j.destacada ? '<i class="fa-solid fa-star text-amber-500"></i>' : '-'}</td>
                    <td class="p-3 text-right space-x-2">
                        <button onclick="editarJornada('${j.id}')" class="px-2.5 py-1 bg-amber-50 hover:bg-amber-100 text-[#1B365D] rounded text-xs font-medium cursor-pointer border border-amber-200">Editar</button>
                        <button onclick="eliminarJornada('${j.id}')" class="px-2.5 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded text-xs font-medium cursor-pointer border border-rose-200">Eliminar</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function guardarJornada(e) {
            e.preventDefault();
            const db = obtenerDB();
            const idEdit = document.getElementById("jornadaIdEdit").value;

            const nuevaJornada = {
                id: idEdit ? idEdit : "anh_" + Date.now(),
                fecha: document.getElementById("inputFecha").value,
                lugar: document.getElementById("inputLugar").value,
                autor: document.getElementById("inputAutor").value,
                titulo: document.getElementById("inputTituloNoticia").value,
                sumario: document.getElementById("inputSumarioNoticia").value,
                contenido: document.getElementById("inputContenidoNoticia").value,
                imagen: document.getElementById("inputImagenUrl").value.trim(),
                destacada: document.getElementById("inputDestacadaPortada").checked
            };

            if (idEdit) {
                const index = db.jornadas.findIndex(item => item.id === idEdit);
                if (index !== -1) {
                    db.jornadas[index] = nuevaJornada;
                }
            } else {
                db.jornadas.push(nuevaJornada);
            }

            guardarDB(db);
            limpiarFormularioJornada();
            alert("¡Publicación guardada y sincronizada en el portal con éxito!");
        }

        function editarJornada(id) {
            const db = obtenerDB();
            const j = db.jornadas.find(item => item.id === id);
            if (!j) return;

            document.getElementById("jornadaIdEdit").value = j.id;
            document.getElementById("inputFecha").value = j.fecha;
            document.getElementById("inputLugar").value = j.lugar;
            document.getElementById("inputAutor").value = j.autor;
            document.getElementById("inputTituloNoticia").value = j.titulo;
            document.getElementById("inputSumarioNoticia").value = j.sumario;
            document.getElementById("inputContenidoNoticia").value = j.contenido;
            document.getElementById("inputImagenUrl").value = j.imagen || "";
            document.getElementById("inputDestacadaPortada").checked = j.destacada || false;

            document.getElementById("formTitulo").innerHTML = `<i class="fa-solid fa-pen-to-square text-[#B48A3E] mr-2"></i> Editando Publicación: ${j.titulo}`;
            document.getElementById("btnGuardarJornada").innerText = "Actualizar Publicación";
            window.scrollTo({ top: document.getElementById("jornadaForm").offsetTop - 100, behavior: 'smooth' });
        }

        function eliminarJornada(id) {
            if (!confirm("¿Estás seguro de que deseas eliminar esta publicación del portal?")) return;
            const db = obtenerDB();
            db.jornadas = db.jornadas.filter(item => item.id !== id);
            guardarDB(db);
            alert("Publicación eliminada correctamente.");
        }

        function limpiarFormularioJornada() {
            document.getElementById("jornadaForm").reset();
            document.getElementById("jornadaIdEdit").value = "";
            document.getElementById("formTitulo").innerHTML = `<i class="fa-solid fa-circle-plus text-[#B48A3E] mr-2"></i> Redactar Nueva Noticia o Artículo`;
            document.getElementById("btnGuardarJornada").innerText = "Publicar Noticia";
            document.getElementById("inputFecha").value = new Date().toISOString().split('T')[0];
        }

        // --- GUARDAR TEXTOS Y ORDEN ---
        function guardarTextosPublicos(e) {
            e.preventDefault();
            const db = obtenerDB();

            db.textos.acercaBadge = document.getElementById("editAcercaBadge").value;
            db.textos.acercaTitulo = document.getElementById("editAcercaTitulo").value;
            db.textos.acercaTexto = document.getElementById("editAcercaTexto").value;
            db.textos.acercaVisible = document.getElementById("editAcercaVisible").checked;
            db.textos.bannerTitulo = document.getElementById("editBannerTitulo").value;
            db.textos.bannerSub = document.getElementById("editBannerSub").value;
            db.textos.labelGranTotal = document.getElementById("editLabelGranTotal").value;
            db.textos.labelKilos = document.getElementById("editLabelKilos").value;
            db.textos.labelCarbono = document.getElementById("editLabelCarbono").value;

            db.orden.acerca = parseInt(document.getElementById("ordenAcerca").value) || 1;
            db.orden.tarjetas = parseInt(document.getElementById("ordenTarjetas").value) || 2;
            db.orden.grafico = parseInt(document.getElementById("ordenGrafico").value) || 3;
            db.orden.materiales = parseInt(document.getElementById("ordenMateriales").value) || 4;
            db.orden.informes = parseInt(document.getElementById("ordenInformes").value) || 5;

            guardarDB(db);
            alert("¡Textos institucionales y orden de diseño actualizados con éxito!");
        }

        // --- LOGO Y CREDENCIALES ---
        function subirLogoArchivo(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(event) {
                const db = obtenerDB();
                db.logoUrl = event.target.result;
                guardarDB(db);
                alert("Sello institucional actualizado correctamente.");
            };
            reader.readAsDataURL(file);
        }

        function restaurarLogoDefecto() {
            const db = obtenerDB();
            db.logoUrl = "";
            guardarDB(db);
            alert("Sello por defecto restaurado.");
        }

        function actualizarCredenciales(e) {
            e.preventDefault();
            const db = obtenerDB();
            const nuevoUsr = document.getElementById("editAdminUsuario").value.trim();
            const nuevoCor = document.getElementById("editAdminCorreo").value.trim();
            const nuevaPwd = document.getElementById("editAdminClave").value.trim();

            db.admin.usuario = nuevoUsr;
            db.admin.correo = nuevoCor;
            if (nuevaPwd) {
                if (nuevaPwd.length < 6) {
                    alert("La nueva clave debe tener al menos 6 caracteres.");
                    return;
                }
                db.admin.clave = nuevaPwd;
            }

            guardarDB(db);
            alert("¡Credenciales editoriales actualizadas con éxito!");
        }

        function cargarDatosBaseAdmin() {
            if (!confirm("¿Deseas recargar las publicaciones institucionales históricas base de la Academia?")) return;
            localStorage.removeItem(DB_KEY);
            renderizarTodo();
            alert("¡Datos institucionales base cargados con éxito!");
        }
    </script>
