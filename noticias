<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>Academia Nacional de la Historia - Portal de Noticias</title>
    <!-- Tailwind CSS y FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Playfair Display e Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Chart.js para gráficos estadísticos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Librería para generar PDFs -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
        .letra-capitular::first-letter {
            font-family: 'Playfair Display', serif;
            font-size: 3.2rem;
            float: left;
            line-height: 0.8;
            padding-right: 0.75rem;
            padding-top: 0.2rem;
            font-weight: bold;
            color: #1B365D;
        }
    </style>
</head>
<body class="bg-[#FAF8F5] text-[#1C1B18] min-h-screen flex flex-col">

    <!-- HEADER / NAVEGACIÓN -->
    <header class="bg-[#1B365D] text-white shadow-md border-b-4 border-[#B48A3E]">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div id="headerLogoContainer" class="bg-white p-1.5 rounded-full text-[#1B365D] font-bold text-xl flex items-center justify-center w-12 h-12 overflow-hidden shadow-sm">
                    <i class="fa-solid fa-landmark-dome"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight font-serif">Academia Nacional de la Historia</h1>
                    <p class="text-xs text-[#B48A3E] flex items-center gap-2 font-medium">
                        <span>Portal Oficial de Noticias e Investigación | RIF: G-20001234-5</span>
                        <span id="cloudStatus" class="inline-flex items-center gap-1 bg-[#152946] text-amber-200 px-2 py-0.5 rounded-full text-[10px]">
                            <i class="fa-solid fa-cloud"></i> Conectando...
                        </span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="cambiarVista('publico')" id="btnPublico" class="px-4 py-2 bg-[#284a7a] hover:bg-[#152946] rounded-lg text-sm font-medium transition shadow-sm border border-[#375e97] cursor-pointer">
                    <i class="fa-solid fa-globe mr-2"></i> Vista Pública
                </button>
                <button onclick="abrirModalAcceso()" id="btnAdminNav" class="px-4 py-2 bg-[#12223b] hover:bg-[#0a1526] rounded-lg text-sm font-medium transition shadow-sm border border-[#B48A3E] text-amber-100 cursor-pointer">
                    <i class="fa-solid fa-lock mr-2"></i> Mesa de Redacción
                </button>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8 space-y-8">

        <!-- MODAL DE ACCESO EXCLUSIVO DE ADMINISTRADOR -->
        <div id="authModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
                <div class="flex justify-between items-center mb-4 border-b pb-3">
                    <h3 class="text-lg font-bold text-[#1B365D] font-serif">
                        <i class="fa-solid fa-shield-halved text-[#B48A3E] mr-2"></i> Acceso Mesa de Redacción
                    </h3>
                    <button onclick="cerrarModalAcceso()" class="text-slate-400 hover:text-slate-600 cursor-pointer"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>

                <form id="formLogin" onsubmit="verificarLogin(event)" class="space-y-4">
                    <p class="text-xs text-slate-500">Acceso exclusivo para editores y Junta Directiva de la Academia.</p>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Usuario:</label>
                        <input type="text" id="loginUsuario" required placeholder="Usuario autorizado" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Contraseña Secreta:</label>
                        <input type="password" id="loginClave" required placeholder="••••••••" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div class="flex justify-between items-center pt-1">
                        <button type="button" onclick="mostrarRecuperacion()" class="text-xs text-[#1B365D] hover:underline font-medium">¿Olvidaste tu clave?</button>
                    </div>
                    <div class="flex justify-end gap-2 pt-2 border-t">
                        <button type="button" onclick="cerrarModalAcceso()" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm">Cancelar</button>
                        <button type="submit" class="px-5 py-2 bg-[#1B365D] hover:bg-[#284a7a] text-white rounded-lg text-sm font-medium cursor-pointer">Iniciar Sesión</button>
                    </div>
                </form>

                <form id="formRecuperar" onsubmit="procesarRecuperacion(event)" class="hidden space-y-4">
                    <p class="text-xs text-slate-600">Ingresa tu <strong>correo electrónico</strong> registrado para verificar identidad:</p>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Correo Electrónico:</label>
                        <input type="email" id="recCorreo" required placeholder="correo@academia.org" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div id="nuevaClaveBox" class="hidden space-y-3 pt-2 border-t">
                        <div class="bg-amber-50 text-[#1B365D] p-2.5 rounded-lg text-xs border border-amber-200">
                            <i class="fa-solid fa-check-circle mr-1 text-[#B48A3E]"></i> Correo verificado (<span id="usuarioRecuperado" class="font-bold"></span>). Define tu nueva clave:
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nueva Contraseña:</label>
                            <input type="password" id="recNuevaClave" minlength="6" placeholder="Mínimo 6 caracteres" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                    </div>
                    <div class="flex justify-between items-center pt-2">
                        <button type="button" onclick="abrirModalAcceso()" class="text-xs text-slate-500 hover:underline"><i class="fa-solid fa-arrow-left mr-1"></i> Volver</button>
                        <button type="submit" id="btnRecuperarSubmit" class="px-4 py-2 bg-[#1B365D] hover:bg-[#284a7a] text-white rounded-lg text-sm font-medium cursor-pointer">Verificar Correo</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- VISTA PÚBLICA -->
        <div id="vistaPublica" class="space-y-8">
            
            <!-- BLOQUE 1: ACERCA DE LA INSTITUCIÓN -->
            <div id="bloqueAcerca" class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row items-center gap-6">
                <div class="p-4 bg-[#FAF8F5] text-[#1B365D] border border-[#B48A3E]/30 rounded-2xl text-4xl flex-shrink-0">
                    <i class="fa-solid fa-book-bookmark"></i>
                </div>
                <div class="space-y-2 text-center md:text-left flex-grow">
                    <span id="pubAcercaBadge" class="text-xs font-bold text-[#B48A3E] bg-amber-50 px-3 py-1 rounded-full uppercase tracking-wider border border-amber-200">Institución Bicentenaria</span>
                    <h2 id="pubAcercaTitulo" class="text-xl md:text-2xl font-bold text-[#1B365D] font-serif">Salvaguarda de la Memoria Histórica Nacional</h2>
                    <p id="pubAcercaTexto" class="text-sm text-slate-600 leading-relaxed font-serif">Fundada para promover la investigación rigurosa, el resguardo documental y la divulgación del devenir histórico venezolano y americano con estricto rigor crítico y académico.</p>
                </div>
                <div class="flex-shrink-0">
                    <a href="https://anhvenezuela.org" target="_blank" class="px-5 py-3 bg-[#1B365D] hover:bg-[#284a7a] text-white rounded-xl text-xs font-semibold shadow-sm transition flex items-center gap-2">
                        <i class="fa-solid fa-globe text-sm"></i> Sitio Institucional
                    </a>
                </div>
            </div>

            <!-- BLOQUE 2: TARJETAS DE RESUMEN / ESTADÍSTICAS EDITORIALES -->
            <div id="bloqueTarjetasResumen" class="space-y-6">
                <div class="bg-gradient-to-r from-[#1B365D] to-[#284a7a] rounded-2xl p-6 md:p-8 text-white shadow-lg flex flex-col md:flex-row justify-between items-center gap-6 border-b-4 border-[#B48A3E]">
                    <div class="space-y-2 text-center md:text-left">
                        <span id="pubBannerBadge" class="bg-[#B48A3E] text-white text-xs px-3 py-1 rounded-full uppercase font-semibold tracking-wider">Boletín en Vivo</span>
                        <h2 id="pubBannerTitulo" class="text-2xl md:text-3xl font-bold font-serif">Crónica y Actualidad Historiográfica</h2>
                        <p id="pubBannerSub" class="text-slate-200 text-sm max-w-xl font-serif">Accede a las últimas investigaciones, incorporaciones de nuevos Individuos de Número y convocatorias oficiales.</p>
                    </div>
                    <div class="bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20 text-center min-w-[200px]">
                        <span id="pubLabelGranTotal" class="block text-xs text-amber-200 uppercase font-medium">Publicaciones Activas</span>
                        <span id="pubGranTotal" class="text-3xl font-extrabold text-white">0</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                        <div class="p-4 bg-amber-50 text-[#B48A3E] rounded-2xl text-2xl border border-amber-100"><i class="fa-solid fa-scroll"></i></div>
                        <div>
                            <p id="pubLabelKilos" class="text-xs text-slate-500 uppercase font-semibold">Artículos y Ensayos Publicados</p>
                            <h3 id="pubTotalKilos" class="text-2xl font-bold text-[#1B365D]">0 Registrados</h3>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-4">
                        <div class="p-4 bg-blue-50 text-[#1B365D] rounded-2xl text-2xl border border-blue-100"><i class="fa-solid fa-award"></i></div>
                        <div>
                            <p id="pubLabelCarbono" class="text-xs text-slate-500 uppercase font-semibold">Condecoraciones y Premios</p>
                            <h3 id="pubHuellaCarbono" class="text-2xl font-bold text-[#1B365D]">Activos</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BLOQUE 3: GRÁFICO HISTÓRICO ANUAL -->
            <div id="bloqueGrafico" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b pb-4">
                    <div>
                        <h3 class="text-lg font-bold text-[#1B365D] font-serif flex items-center gap-2">
                            <i class="fa-solid fa-chart-line text-[#B48A3E]"></i> Producción Historiográfica por Años
                        </h3>
                        <p class="text-xs text-slate-500">Distribución cronológica de las publicaciones y boletines de la Academia.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Filtrar por Sección:</label>
                            <select id="filtroMaterialGrafico" onchange="actualizarGraficoLineasAnual()" class="px-3 py-1.5 border rounded-lg text-xs bg-white font-medium focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                                <option value="todos">Todas las Secciones</option>
                                <option value="Institucional y Directiva">Institucional y Directiva</option>
                                <option value="Individuos de Número / Conmemoraciones">Individuos de Número</option>
                                <option value="Investigaciones y Artículos">Investigaciones y Artículos</option>
                                <option value="Boletín y Publicaciones">Boletín y Publicaciones</option>
                                <option value="Eventos, Conferencias y Concursos">Eventos y Concursos</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="relative h-80 w-full">
                    <canvas id="lineChartCanvas"></canvas>
                </div>
            </div>

            <!-- BLOQUE 4: DISTRIBUCIÓN POR CATEGORÍAS ACADÉMICAS -->
            <div id="bloqueMaterialesPorcentaje" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
                <h3 class="text-lg font-bold text-[#1B365D] font-serif mb-6 flex items-center gap-2">
                    <i class="fa-solid fa-layer-group text-[#B48A3E]"></i> Distribución de Contenidos por Categorías Académicas
                </h3>
                <div id="pubListaMateriales" class="space-y-4"></div>
            </div>

            <!-- BLOQUE 5: CENTRO DE INFORMES / NOTICIAS Y BUSCADOR -->
            <div id="bloqueInformesBuscador" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
                <div class="border border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                    <button onclick="toggleAcordeonBuscador()" class="w-full px-5 py-4 flex justify-between items-center text-left font-bold text-[#1B365D] hover:bg-slate-100 transition cursor-pointer">
                        <span class="flex items-center gap-2 text-base font-serif">
                            <i class="fa-solid fa-magnifying-glass text-[#B48A3E]"></i> Buscador Avanzado en el Archivo de Noticias
                        </span>
                        <i id="iconoAcordeon" class="fa-solid fa-chevron-down text-slate-500 transition-transform duration-300"></i>
                    </button>
                    <div id="contenidoAcordeon" class="hidden p-5 border-t border-slate-200 bg-white grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Seleccionar Noticia Directa:</label>
                            <select id="selectInformeRapido" onchange="seleccionarInformeDirecto(this.value)" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none bg-white">
                                <option value="">-- Todas las publicaciones --</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Buscar por Fecha:</label>
                            <input type="date" id="filtroFecha" oninput="filtrarInformesPublicos()" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Buscar por Título, Autor o Tema:</label>
                            <div class="flex gap-2">
                                <input type="text" id="filtroTexto" oninput="filtrarInformesPublicos()" placeholder="ej. Tutor, Individuo, Boletín..." class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                                <button onclick="limpiarFiltrosBusqueda()" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs rounded-lg font-medium transition cursor-pointer" title="Limpiar filtros">Limpiar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="text-lg font-bold text-[#1B365D] font-serif mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-newspaper text-[#B48A3E]"></i> Publicaciones y Comunicados Oficiales
                    </h3>
                    <p class="text-sm text-slate-600 mb-6 font-serif">Selecciona una publicación para leer el texto completo, ver detalles académicos y obtener la cita bibliográfica automática:</p>
                    
                    <!-- Cuadrícula de publicaciones -->
                    <div id="pubListaInformes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

                    <!-- Paginación Interactiva -->
                    <div id="paginacionContenedor" class="flex flex-wrap items-center justify-center gap-2 mt-8 pt-4 border-t border-slate-200"></div>
                </div>
            </div>
        </div>

        <!-- VISTA DE ADMINISTRACIÓN (MESA DE REDACCIÓN) -->
        <div id="vistaAdmin" class="hidden space-y-8">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <div>
                    <h2 class="text-xl font-bold text-[#1B365D] font-serif"><i class="fa-solid fa-feather-pointed text-[#B48A3E] mr-2"></i> Mesa de Redacción y Sincronización</h2>
                    <p class="text-sm text-slate-500">Editor en jefe: <strong id="adminNombreDisplay" class="text-[#1B365D]">Miembro de la Junta</strong>.</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="cargarDatosBaseAdmin()" class="px-3 py-2 bg-amber-50 hover:bg-amber-100 text-[#1B365D] rounded-lg text-xs font-medium transition cursor-pointer border border-amber-200" title="Cargar noticias institucionales base de la Academia">
                        <i class="fa-solid fa-database mr-1"></i> Cargar Noticias Históricas Base
                    </button>
                    <button onclick="cerrarAdmin()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition cursor-pointer">
                        <i class="fa-solid fa-right-from-bracket mr-2"></i> Cerrar Sesión
                    </button>
                </div>
            </div>

            <!-- GESTIÓN DE ORDEN DE LOS BLOQUES -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
                <h3 class="text-base font-bold text-[#1B365D] font-serif flex items-center gap-2 border-b pb-2">
                    <i class="fa-solid fa-list-ol text-[#B48A3E]"></i> Orden de las Secciones en el Portal Público
                </h3>
                <p class="text-xs text-slate-500">Asigna un número del 1 al 5 a cada bloque:</p>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 pt-2">
                    <div class="bg-slate-50 p-3 rounded-xl border">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Acerca de la Institución:</label>
                        <input type="number" id="ordenAcerca" min="1" max="5" class="w-full px-3 py-1.5 border rounded-lg text-sm bg-white">
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl border">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Tarjetas y Banner:</label>
                        <input type="number" id="ordenTarjetas" min="1" max="5" class="w-full px-3 py-1.5 border rounded-lg text-sm bg-white">
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl border">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Gráfico Histórico:</label>
                        <input type="number" id="ordenGrafico" min="1" max="5" class="w-full px-3 py-1.5 border rounded-lg text-sm bg-white">
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl border">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Categorías Académicas:</label>
                        <input type="number" id="ordenMateriales" min="1" max="5" class="w-full px-3 py-1.5 border rounded-lg text-sm bg-white">
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl border">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Buscador y Noticias:</label>
                        <input type="number" id="ordenInformes" min="1" max="5" class="w-full px-3 py-1.5 border rounded-lg text-sm bg-white">
                    </div>
                </div>
            </div>

            <!-- GESTIÓN DE TEXTOS Y TÍTULOS -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
                <h3 class="text-base font-bold text-[#1B365D] font-serif flex items-center gap-2 border-b pb-2">
                    <i class="fa-solid fa-pen-to-square text-[#B48A3E]"></i> Edición de Textos Institucionales
                </h3>
                <form onsubmit="guardarTextosPublicos(event)" class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Etiqueta "Acerca" (Badge):</label>
                            <input type="text" id="editAcercaBadge" required class="w-full px-3 py-2 border rounded-lg text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Título "Acerca de la Institución":</label>
                            <input type="text" id="editAcercaTitulo" required class="w-full px-3 py-2 border rounded-lg text-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Descripción de la Institución:</label>
                        <textarea id="editAcercaTexto" rows="2" required class="w-full px-3 py-2 border rounded-lg text-sm"></textarea>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Título del Banner Principal:</label>
                            <input type="text" id="editBannerTitulo" required class="w-full px-3 py-2 border rounded-lg text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Subtítulo del Banner:</label>
                            <input type="text" id="editBannerSub" required class="w-full px-3 py-2 border rounded-lg text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Etiqueta Contador Total:</label>
                            <input type="text" id="editLabelGranTotal" required class="w-full px-3 py-2 border rounded-lg text-sm">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Etiqueta Tarjeta Artículos:</label>
                            <input type="text" id="editLabelKilos" required class="w-full px-3 py-2 border rounded-lg text-sm">
                        </div>
                        <div>
