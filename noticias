        function guardarDB(db) {
            localStorage.setItem(DB_KEY, JSON.stringify(db));
            sincronizarNubeEstado();
            renderizarTodo();
        }

        function sincronizarNubeEstado() {
            const status = document.getElementById("cloudStatus");
            if(status) {
                status.innerHTML = `<i class="fa-solid fa-cloud-arrow-up animate-pulse"></i> Sincronizado en línea`;
                setTimeout(() => {
                    status.innerHTML = `<i class="fa-solid fa-cloud"></i> Sincronizado en línea`;
                }, 1500);
            }
        }

        // Inicialización al cargar la ventana
        window.addEventListener("DOMContentLoaded", () => {
            renderizarTodo();
            verificarEstadoSesion();
        });

        function renderizarTodo() {
            const db = obtenerDB();
            
            // Logo
            const logoContainer = document.getElementById("headerLogoContainer");
            const adminPreview = document.getElementById("adminLogoPreview");
            if (db.logoUrl) {
                logoContainer.innerHTML = `<img src="${db.logoUrl}" class="w-full h-full object-cover">`;
                adminPreview.innerHTML = `<img src="${db.logoUrl}" class="w-full h-full object-cover">`;
            } else {
                logoContainer.innerHTML = `<i class="fa-solid fa-landmark-dome"></i>`;
                adminPreview.innerHTML = `<i class="fa-solid fa-landmark-dome"></i>`;
            }

            // Textos públicos
            document.getElementById("pubAcercaBadge").innerText = db.textos.acercaBadge;
            document.getElementById("pubAcercaTitulo").innerText = db.textos.acercaTitulo;
            document.getElementById("pubAcercaTexto").innerText = db.textos.acercaTexto;
            document.getElementById("pubBannerTitulo").innerText = db.textos.bannerTitulo;
            document.getElementById("pubBannerSub").innerText = db.textos.bannerSub;
            document.getElementById("pubLabelGranTotal").innerText = db.textos.labelGranTotal;
            document.getElementById("pubLabelKilos").innerText = db.textos.labelKilos;
            document.getElementById("pubLabelCarbono").innerText = db.textos.labelCarbono;

            // Visibilidad de Acerca
            const bloqueAcerca = document.getElementById("bloqueAcerca");
            if (db.textos.acercaVisible) {
                bloqueAcerca.classList.remove("hidden");
            } else {
                bloqueAcerca.classList.add("hidden");
            }

            // Orden de bloques
            ordenarBloquesVistaPublica(db.orden);

            // Poblar inputs admin de textos y orden
            document.getElementById("editAcercaBadge").value = db.textos.acercaBadge;
            document.getElementById("editAcercaTitulo").value = db.textos.acercaTitulo;
            document.getElementById("editAcercaTexto").value = db.textos.acercaTexto;
            document.getElementById("editAcercaVisible").checked = db.textos.acercaVisible;
            document.getElementById("editBannerTitulo").value = db.textos.bannerTitulo;
            document.getElementById("editBannerSub").value = db.textos.bannerSub;
            document.getElementById("editLabelGranTotal").value = db.textos.labelGranTotal;
            document.getElementById("editLabelKilos").value = db.textos.labelKilos;
            document.getElementById("editLabelCarbono").value = db.textos.labelCarbono;

            document.getElementById("ordenAcerca").value = db.orden.acerca;
            document.getElementById("ordenTarjetas").value = db.orden.tarjetas;
            document.getElementById("ordenGrafico").value = db.orden.grafico;
            document.getElementById("ordenMateriales").value = db.orden.materiales;
            document.getElementById("ordenInformes").value = db.orden.informes;

            document.getElementById("editAdminUsuario").value = db.admin.usuario;
            document.getElementById("editAdminCorreo").value = db.admin.correo;

            // Totales
            const totalPublicaciones = db.jornadas.length;
            document.getElementById("pubGranTotal").innerText = totalPublicaciones;
            document.getElementById("pubTotalKilos").innerText = totalPublicaciones + " Registradas";

            // Renderizar gráficos y listas
            renderizarPorcentajeMateriales(db.jornadas);
            renderizarListaInformesPublicos(db.jornadas);
            actualizarGraficoLineasAnual();
            poblarSelectsInformes(db.jornadas);
            renderizarTablaAdmin(db.jornadas);
        }

        function ordenarBloquesVistaPublica(orden) {
            const vistaPublica = document.getElementById("vistaPublica");
            const mapaBloques = {
                acerca: document.getElementById("bloqueAcerca"),
                tarjetas: document.getElementById("bloqueTarjetasResumen"),
                grafico: document.getElementById("bloqueGrafico"),
                materiales: document.getElementById("bloqueMaterialesPorcentaje"),
                informes: document.getElementById("bloqueInformesBuscador")
            };

            // Ordenar array según los números asignados
            const ordenArray = Object.keys(orden).sort((a, b) => orden[a] - orden[b]);
            ordenArray.forEach(key => {
                if(mapaBloques[key]) {
                    vistaPublica.appendChild(mapaBloques[key]);
                }
            });
        }

        // --- NAVEGACIÓN Y VISTAS ---
        function cambiarVista(vista) {
            const vPublica = document.getElementById("vistaPublica");
            const vAdmin = document.getElementById("vistaAdmin");
            const btnPub = document.getElementById("btnPublico");
            const btnAdm = document.getElementById("btnAdminNav");

            if (vista === "publico") {
                vPublica.classList.remove("hidden");
                vAdmin.classList.add("hidden");
                btnPub.classList.add("bg-[#284a7a]");
                btnAdm.classList.remove("bg-[#284a7a]");
            } else {
                const db = obtenerDB();
                if (!db.sesionAdmin) {
                    abrirModalAcceso();
                    return;
                }
                vPublica.classList.add("hidden");
                vAdmin.classList.remove("hidden");
                btnAdm.classList.add("bg-[#284a7a]");
                btnPub.classList.remove("bg-[#284a7a]");
            }
        }

        // --- AUTENTICACIÓN ADMIN ---
        function abrirModalAcceso() {
            document.getElementById("authModal").classList.remove("hidden");
            document.getElementById("formLogin").classList.remove("hidden");
            document.getElementById("formRecuperar").classList.add("hidden");
            document.getElementById("loginUsuario").value = "";
            document.getElementById("loginClave").value = "";
        }

        function cerrarModalAcceso() {
            document.getElementById("authModal").classList.add("hidden");
        }

        function verificarLogin(e) {
            e.preventDefault();
            const usr = document.getElementById("loginUsuario").value.trim();
            const pwd = document.getElementById("loginClave").value.trim();
            const db = obtenerDB();

            if (usr === db.admin.usuario && pwd === db.admin.clave) {
                db.sesionAdmin = true;
                db.adminUsuarioActual = usr;
                guardarDB(db);
                cerrarModalAcceso();
                document.getElementById("adminNombreDisplay").innerText = db.admin.nombre;
                cambiarVista("admin");
            } else {
                alert("Usuario o contraseña incorrectos.");
            }
        }

        function cerrarAdmin() {
            const db = obtenerDB();
            db.sesionAdmin = false;
            guardarDB(db);
            cambiarVista("publico");
        }

        function verificarEstadoSesion() {
            const db = obtenerDB();
            if (db.sesionAdmin) {
                document.getElementById("adminNombreDisplay").innerText = db.admin.nombre;
            }
        }

        function mostrarRecuperacion() {
            document.getElementById("formLogin").classList.add("hidden");
            document.getElementById("formRecuperar").classList.remove("hidden");
            document.getElementById("nuevaClaveBox").classList.add("hidden");
            document.getElementById("recCorreo").value = "";
        }

        function procesarRecuperacion(e) {
            e.preventDefault();
            const correoIngresado = document.getElementById("recCorreo").value.trim();
            const db = obtenerDB();
            const nuevaClaveBox = document.getElementById("nuevaClaveBox");
            const btnSub = document.getElementById("btnRecuperarSubmit");

            if (nuevaClaveBox.classList.contains("hidden")) {
                if (correoIngresado.toLowerCase() === db.admin.correo.toLowerCase()) {
                    document.getElementById("usuarioRecuperado").innerText = db.admin.usuario;
                    nuevaClaveBox.classList.remove("hidden");
                    btnSub.innerText = "Guardar Nueva Contraseña";
                } else {
                    alert("El correo ingresado no coincide con el registro de la Academia.");
                }
            } else {
                const nuevaClave = document.getElementById("recNuevaClave").value.trim();
                if (nuevaClave.length < 6) {
                    alert("La contraseña debe tener al menos 6 caracteres.");
                    return;
                }
                db.admin.clave = nuevaClave;
                guardarDB(db);
                alert("¡Contraseña actualizada con éxito! Ya puedes iniciar sesión.");
                abrirModalAcceso();
            }
        }

        // --- RENDERIZADO PÚBLICO ---
        function renderizarPorcentajeMateriales(jornadas) {
            const contenedor = document.getElementById("pubListaMateriales");
            contenedor.innerHTML = "";

            const categorias = [
                "Institucional y Directiva",
                "Individuos de Número / Conmemoraciones",
                "Investigaciones y Artículos",
                "Boletín y Publicaciones",
                "Eventos, Conferencias y Concursos"
            ];

            const conteo = {};
            categorias.forEach(cat => conteo[cat] = 0);

            jornadas.forEach(j => {
                if (conteo[j.lugar] !== undefined) {
                    conteo[j.lugar]++;
                } else {
                    conteo[j.lugar] = (conteo[j.lugar] || 0) + 1;
                }
            });

            const total = jornadas.length || 1;

            Object.keys(conteo).forEach(cat => {
                const cant = conteo[cat];
                const porcentaje = Math.round((cant / total) * 100);

                const div = document.createElement("div");
                div.className = "space-y-1";
                div.innerHTML = `
                    <div class="flex justify-between text-xs font-semibold text-slate-700">
                        <span>${cat}</span>
                        <span>${cant} publicaciones (${porcentaje}%)</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                        <div class="bg-[#1B365D] h-2.5 rounded-full transition-all duration-500" style="width: ${porcentaje}%"></div>
                    </div>
                `;
                contenedor.appendChild(div);
            });
        }

        function renderizarListaInformesPublicos(jornadas) {
            const contenedor = document.getElementById("pubListaInformes");
            const pagContenedor = document.getElementById("paginacionContenedor");
            
            // Aplicar filtros de búsqueda
            const fechaFiltro = document.getElementById("filtroFecha").value;
            const textoFiltro = document.getElementById("filtroTexto").value.toLowerCase();

            let filtradas = jornadas.filter(j => {
                let coincideFecha = fechaFiltro ? j.fecha === fechaFiltro : true;
                let coincideTexto = textoFiltro ? (
                    j.titulo.toLowerCase().includes(textoFiltro) ||
                    j.sumario.toLowerCase().includes(textoFiltro) ||
                    j.autor.toLowerCase().includes(textoFiltro) ||
                    j.lugar.toLowerCase().includes(textoFiltro)
                ) : true;
                return coincideFecha && coincideTexto;
            });

            // Ordenar por fecha descendente
            filtradas.sort((a, b) => new Date(b.fecha) - new Date(a.fecha));

            const totalPaginas = Math.ceil(filtradas.length / porPagina) || 1;
            if (paginaActual > totalPaginas) paginaActual = totalPaginas;

            const inicio = (paginaActual - 1) * porPagina;
            const paginadas = filtradas.slice(inicio, inicio + porPagina);

            contenedor.innerHTML = "";
            if (paginadas.length === 0) {
                contenedor.innerHTML = `<div class="col-span-full text-center py-8 text-slate-500 text-sm">No se encontraron publicaciones con los criterios seleccionados.</div>`;
                pagContenedor.innerHTML = "";
                return;
            }

            paginadas.forEach(j => {
                const tarjeta = document.createElement("div");
                tarjeta.className = "bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between";
                tarjeta.innerHTML = `
                    <div>
                        ${j.imagen ? `<div class="h-48 overflow-hidden"><img src="${j.imagen}" alt="Imagen" class="w-full h-full object-cover"></div>` : `<div class="h-24 bg-gradient-to-r from-[#1B365D] to-[#284a7a] flex items-center justify-center text-white p-4 font-serif font-bold text-center">${j.lugar}</div>`}
                        <div class="p-5 space-y-2">
                            <div class="flex justify-between items-center text-xs">
                                <span class="bg-amber-50 text-[#B48A3E] font-bold px-2.5 py-1 rounded-full border border-amber-200">${j.lugar}</span>
                                <span class="text-slate-400"><i class="fa-regular fa-calendar mr-1"></i>${j.fecha}</span>
                            </div>
                            <h4 class="text-base font-bold text-[#1B365D] font-serif line-clamp-2">${j.titulo}</h4>
                            <p class="text-xs text-slate-600 line-clamp-2 font-serif">${j.sumario}</p>
                            <p class="text-[11px] text-slate-400 italic">Por: ${j.autor}</p>
                        </div>
                    </div>
                    <div class="p-5 pt-0 flex items-center justify-between border-t border-slate-100 mt-2">
                        <button onclick="abrirModalLectura('${j.id}')" class="w-full mt-3 py-2 bg-[#1B365D] hover:bg-[#284a7a] text-white rounded-xl text-xs font-semibold transition cursor-pointer flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Leer Artículo Completo
                        </button>
                    </div>
                `;
                contenedor.appendChild(tarjeta);
            });

            // Paginación
            pagContenedor.innerHTML = "";
            for (let i = 1; i <= totalPaginas; i++) {
                const btn = document.createElement("button");
                btn.className = `px-3 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer ${i === paginaActual ? 'bg-[#1B365D] text-white' : 'bg-slate-200 text-slate-700 hover:bg-slate-300'}`;
                btn.innerText = i;
                btn.onclick = () => {
                    paginaActual = i;
                    renderizarListaInformesPublicos(obtenerDB().jornadas);
                };
                pagContenedor.appendChild(btn);
            }
        }

        function filtrarInformesPublicos() {
            paginaActual = 1;
            renderizarListaInformesPublicos(obtenerDB().jornadas);
        }

        function limpiarFiltrosBusqueda() {
            document.getElementById("filtroFecha").value = "";
            document.getElementById("filtroTexto").value = "";
            document.getElementById("selectInformeRapido").value = "";
            paginaActual = 1;
            renderizarListaInformesPublicos(obtenerDB().jornadas);
        }

        function poblarSelectsInformes(jornadas) {
            const selectRapido = document.getElementById("selectInformeRapido");
            selectRapido.innerHTML = `<option value="">-- Todas las publicaciones --</option>`;
            jornadas.forEach(j => {
                const opt = document.createElement("option");
                opt.value = j.id;
                opt.innerText = `${j.fecha} - ${j.titulo}`;
                selectRapido.appendChild(opt);
